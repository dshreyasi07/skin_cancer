), labels)\n            if train:\n                scaler.scale(loss).backward()\n                scaler.step(optimizer)\n                scaler.update()\n            total_loss += loss.item() * images.size(0)\n            correct += (outputs.argmax(dim=1) == labels).sum().item()\n            total += labels.size(0)\n            pbar.set_postfix(loss=f\"{loss.item():.4f}\", acc=f\"{correct/total:.4f}\")\n        torch.set_grad_enabled(True)\n        return total_loss / total, correct / total\n\n    best_val_acc, bad_epochs = 0.0, 0\n    history = {\"train_loss\": [], \"train_acc\": [], \"val_loss\": [], \"val_acc\": []}\n\n    for epoch in range(epochs):\n        print(f\"\\n--- Epoch {epoch+1}/{epochs} ---\")\n        train_loss, train_acc = run_epoch(train_loader, train=True)\n        val_loss, val_acc = run_epoch(val_loader, train=False)\n        scheduler.step()\n\n        for k, v in zip(history, (train_loss, train_acc, val_loss, val_acc)):\n            history[k].append(v)\n        print(f\"Epoch {epoch+1}/{epochs} | train_loss {train_loss:.4f} train_acc {train_acc:.4f} | \"\n              f\"val_loss {val_loss:.4f} val_acc {val_acc:.4f}\")\n\n        if val_acc > best_val_acc:\n            best_val_acc, bad_epochs = val_acc, 0\n            sd = model.module.state_dict() if hasattr(model, \"module\") else model.state_dict()\n            torch.save(sd, checkpoint_path)\n            print(f\"  -> saved new best model (val_acc={val_acc:.4f})\")\n        else:\n            bad_epochs += 1\n            if patience and bad_epochs >= patience:\n                print(\"Early stopping: no val improvement for\", patience, \"epochs\")\n                break\n    return history","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-25T05:04:53.123202Z","iopub.execute_input":"2026-10-25T05:04:53.123637Z","iopub.status.idle":"2026-10-25T05:04:53.134121Z","shell.execute_reply.started":"2026-10-25T05:04:53.123614Z","shell.execute_reply":"2026-10-25T05:04:53.133